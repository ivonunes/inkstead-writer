@component SiteStyles() {
  @style {
    :root {
      color-scheme: light dark;
      --background: #fbfaf7;
      --text: #201d19;
      --muted: #777168;
      --soft: #918a80;
      --line: rgba(32, 29, 25, 0.13);
      --line-strong: rgba(32, 29, 25, 0.2);
      --link: #201d19;
      --link-hover: #6f665c;
      --selection: rgba(32, 29, 25, 0.12);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --background: #0f1112;
        --text: #ece7df;
        --muted: #979089;
        --soft: #b8b0a7;
        --line: rgba(236, 231, 223, 0.12);
        --line-strong: rgba(236, 231, 223, 0.18);
        --link: #ece7df;
        --link-hover: #bdb5ac;
        --selection: rgba(236, 231, 223, 0.14);
      }
    }
    * { box-sizing: border-box; }
    ::selection { background: var(--selection); }
    body {
      margin: 0;
      font: 16px/1.68 "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      color: var(--text);
      background: var(--background);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .site-header, main, .site-footer {
      width: min(900px, calc(100% - 48px));
      margin: 0 auto;
    }
    .site-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 28px;
      padding: 32px 0 19px;
      border-bottom: 1px solid var(--line);
    }
    main { padding: 0 0 0; }
    .site-footer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: baseline;
      gap: 18px;
      padding: 18px 0 32px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.86rem;
    }
    .site-footer p { margin: 0; }
    .site-footer a { color: var(--muted); }
    .site-footer a:hover { color: var(--text); }
    .site-footer-credit { text-align: center; }
    .site-footer p:last-child { text-align: right; }
    a {
      color: var(--link);
      text-decoration-thickness: 0.06em;
      text-underline-offset: 0.16em;
    }
    a:hover { color: var(--link-hover); }
    img {
      max-width: 100%;
      height: auto;
      border-radius: 3px;
    }
    h1 {
      margin: 0 0 0.72em;
      font-size: 2.15rem;
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: 0;
    }
    h2 {
      margin: 2.1em 0 0.55em;
      font-size: 1.42rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0;
    }
    p { margin: 0 0 1.25em; }
    time { color: var(--muted); }
    .site-title {
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: 1.9rem;
      font-weight: 500;
      line-height: 1;
      text-decoration: none;
    }
    .site-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      font-size: 0.94rem;
    }
    .site-nav a {
      color: var(--text);
      text-decoration: none;
    }
    .site-nav a:hover { color: var(--link-hover); }
    .home-intro {
      padding: 54px 0 39px;
      border-bottom: 1px solid var(--line);
    }
    .home-intro h1 {
      max-width: 620px;
      margin-bottom: 16px;
      font-size: 2rem;
    }
    .home-intro p {
      max-width: 450px;
      color: var(--muted);
      font-size: 1.08rem;
      line-height: 1.5;
    }
    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      min-height: 40px;
      padding: 24px 0 28px;
    }
    .pagination a,
    .pagination span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      color: var(--text);
      font-size: 1rem;
      text-decoration: none;
    }
    .pagination > span[aria-hidden="true"] { color: var(--muted); }
    .pagination-status { gap: 14px; color: var(--muted); }
    .pagination-status [aria-current="page"] {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
    .muted { color: var(--muted); }
    .post-list {
      display: grid;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .post-list-item {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 64px;
      padding: 27px 0 28px;
      border-bottom: 1px solid var(--line);
    }
    .post-date {
      padding-top: 5px;
      font-size: 0.94rem;
      line-height: 1.35;
    }
    .post-body {
      max-width: 455px;
      min-width: 0;
    }
    .post-title {
      display: inline-block;
      color: var(--text);
      font-size: 1.55rem;
      font-weight: 500;
      line-height: 1.18;
      text-decoration: none;
    }
    .post-title:hover {
      color: var(--link-hover);
      text-decoration: underline;
    }
    .post-meta {
      font-size: 0.95rem;
    }
    a.post-meta {
      width: max-content;
      color: var(--muted);
      text-decoration: none;
    }
    a.post-meta:hover {
      color: var(--text);
      text-decoration: underline;
    }
    .post-list .e-content {
      margin-top: 0;
      color: var(--text);
      font-size: 1.02rem;
      line-height: 1.62;
    }
    .post-list .e-content p:last-child { margin-bottom: 0; }
    .p-summary {
      margin-top: 12px;
      color: var(--text);
      font-size: 1.01rem;
      line-height: 1.62;
    }
    .p-summary > :first-child { margin-top: 0; }
    .p-summary > :last-child { margin-bottom: 0; }
    .read-more {
      margin-top: 16px;
      margin-bottom: 0;
      font-size: 0.98rem;
    }
    .read-more a { text-decoration: none; }
    .read-more a:hover { text-decoration: underline; }
    .single-entry,
    .page-content {
      max-width: 680px;
      padding: 54px 0 72px;
    }
    .single-entry h1,
    .page-content h1 {
      max-width: 620px;
      font-size: 2.2rem;
    }
    .single-entry > time {
      display: block;
      margin-bottom: 34px;
      font-size: 0.95rem;
    }
    .e-content,
    .page-content {
      font-size: 1.08rem;
    }
    .e-content { margin-top: 32px; }
    .e-content > * + * { margin-top: 1.1em; }
    .e-content a,
    .page-content a { text-decoration-thickness: 0.05em; }
    .e-content blockquote,
    .page-content blockquote {
      margin: 1.8em 0;
      padding-left: 1.2em;
      border-left: 1px solid var(--line-strong);
      color: var(--muted);
    }
    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 36px;
    }
    .categories a {
      color: var(--muted);
      font-size: 0.9rem;
      text-decoration: none;
    }
    .categories a:hover { color: var(--text); }
    @media (max-width: 640px) {
      .site-header, main, .site-footer {
        width: min(100% - 32px, 900px);
      }
      .site-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 20px;
        padding-top: 26px;
      }
      .site-title { font-size: 1.65rem; }
      .site-nav { gap: 18px; }
      .site-footer {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }
      .site-footer-credit,
      .site-footer p:last-child {
        text-align: left;
      }
      .home-intro { padding: 42px 0 32px; }
      .home-intro h1,
      .single-entry h1,
      .page-content h1 {
        font-size: 1.82rem;
      }
      .post-list-item {
        grid-template-columns: 1fr;
        gap: 10px;
        padding: 24px 0 26px;
      }
      .post-date { padding-top: 0; }
      .post-body { max-width: none; }
      .post-title { font-size: 1.42rem; }
      .single-entry,
      .page-content {
        padding: 42px 0 60px;
      }
    }
  }
}
