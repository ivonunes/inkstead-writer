@component SiteFooter() {
  <footer class="site-footer">
    <p>&copy; {now.year} {site.author}</p>
    @if config.theme.showPoweredBy != false {
    <p class="site-footer-credit">Written in <a href="https://inkstead.app" target="_blank" rel="noopener noreferrer">Inkstead</a></p>
    }
    <p><a href="#top">Top &uarr;</a></p>
  </footer>
}
